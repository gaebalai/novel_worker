# novel_worker 환경설정. 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
# .env 는 git 에 올라가지 않는다. 키는 중계기(bridge)만 읽고, Claude Code 본체와 소설 엔진에는 넘어가지 않는다.
# 형식: KEY=값  (따옴표는 있어도 없어도 된다. 값 안의 공백·$·# 도 그대로 읽는다. # 로 시작하는 줄은 주석)
#
# 등록한 키에 따라 모델 구성(모드)이 자동으로 정해진다 — 자세히는 docs/GETTING_STARTED.md
#   Anthropic 만                 → solo (최소. Sonnet 이 쓰고 Sonnet 이 심사)
#   Anthropic + OpenAI           → duo  (권장. Sonnet 이 쓰고 GPT 가 심사)
#   다섯 회사 모두               → all  (기획안을 다섯 회사가 낸다)

# ── 필수 ─────────────────────────────────────────────
# Anthropic(Claude Sonnet 5.5). https://platform.claude.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=

# ── 권장 ─────────────────────────────────────────────
# OpenAI(GPT 6.1-Sol). OpenAI 대시보드(platform.openai.com)의 API keys 메뉴에서 발급
OPENAI_API_KEY=

# ── 선택 (있으면 기획안 제안에 더해지고, 다섯 개 모두 있으면 all 모드) ──
# Zhipu GLM (z.ai)
ZAI_API_KEY=
# Alibaba Qwen (Model Studio 국제판)
DASHSCOPE_API_KEY=
# Moonshot Kimi
KIMI_API_KEY=

# ── 고급 설정 (보통은 그대로) ────────────────────────
# 모드를 직접 고정: solo | duo | all  (비우면 키를 보고 자동 선택)
# NOVEL_KEY_MODE=duo
# 중국 본토 계정이면 업체 주소를 바꾼다
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
# 중계기 포트(기본 8788). 실행기·엔진·기획 도구가 모두 이 값을 따른다
# NOVEL_BRIDGE_PORT=8788
